# ---- 저장소 ----
# s3 = MinIO 사용, local = 로컬 디렉터리(개발·테스트용)
STORAGE_BACKEND=s3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=localhost:9000
S3_BUCKET=productivity
S3_USE_SSL=false
LOCAL_DATA_DIR=./data

# ---- 수집 ----
TIMEZONE=Asia/Seoul
# 콤마 구분. 지정 경로 자체 또는 하위 1단계에서 .git 저장소를 찾음
GIT_REPO_ROOTS=~/IdeaProjects
# 콤마 구분. 비우면 모든 작성자의 커밋 수집
GIT_AUTHOR_EMAILS=
# ---- 작업 시간 추정 (커밋 간격 기반) ----
# 직전 커밋과 이 간격(분) 이하면 그 사이를 연속 작업으로 간주
WORK_MAX_GAP_MIN=120
# 세션 첫 커밋 전 작업 시간(분)
WORK_FIRST_COMMIT_MIN=30

# ---- ActivityWatch (선택, 기본 꺼짐) ----
ENABLE_ACTIVITYWATCH=false
ACTIVITYWATCH_URL=http://localhost:5600
# 코딩 시간으로 집계할 앱 이름(부분 일치, 대소문자 무시)
CODING_APPS=idea,pycharm,webstorm,datagrip,goland,clion,rider,android studio,code,cursor,xcode,terminal,iterm,warp,ghostty
